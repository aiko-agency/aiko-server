PORT=5002
# Configuration SendGrid (service d'envoi d'emails professionnel)
EMAIL_SERVICE=sendgrid
EMAIL_USER=apikey
# Remplacez par votre clé API SendGrid
EMAIL_PASS=SG.votre-cle-api-sendgrid
